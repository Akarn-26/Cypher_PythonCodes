import random
def encryption(text,hashmap):
    t=""
    for i in text:
        if i in hashmap:
            t+=hashmap[i]
        else:
            t+=i
    return t
def decryption(text,hashmap):
    t=""
    for i in text:
        if i in hashmap:
            t+=hashmap[i]
        else:
            t+=i
    return t
